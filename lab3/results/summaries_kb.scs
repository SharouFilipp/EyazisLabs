// ===== Документ 11: Le reti di calcolatori e l'architettura dei protocolli di Internet =====
document_11
<- concept_document;
<- concept_scientific_article_computer_science;
=> nrel_main_idtf: [Le reti di calcolatori e l'architettura dei protocolli di Internet] (* <- lang_it;; *);
=> nrel_text_language: lang_it;
=> nrel_source_document: [http://localhost:8003/documents/11/file];
=> nrel_summary: classic_summary_11;
=> nrel_keywords: keyword_summary_11;;

classic_summary_11
<- concept_classic_summary;
=> nrel_summarization_method: method_sentence_extraction;
-> rrel_1: ..sentence_11_1;
-> rrel_2: ..sentence_11_2;
-> rrel_3: ..sentence_11_3;
-> rrel_4: ..sentence_11_4;
-> rrel_5: ..sentence_11_5;
-> rrel_6: ..sentence_11_6;
-> rrel_7: ..sentence_11_7;
-> rrel_8: ..sentence_11_8;
-> rrel_9: ..sentence_11_9;
-> rrel_10: ..sentence_11_10;;

..sentence_11_1
<- concept_sentence;
=> nrel_main_idtf: [Una rete di calcolatori è un insieme di dispositivi collegati tra loro che possono scambiarsi dati e condividere risorse.] (* <- lang_it;; *);;

..sentence_11_2
<- concept_sentence;
=> nrel_main_idtf: [Dalle piccole reti domestiche fino alla rete mondiale Internet, la comunicazione tra calcolatori è diventata una componente essenziale della vita economica e sociale.] (* <- lang_it;; *);;

..sentence_11_3
<- concept_sentence;
=> nrel_main_idtf: [Perché due calcolatori possano comunicare, devono rispettare regole comuni chiamate protocolli.] (* <- lang_it;; *);;

..sentence_11_4
<- concept_sentence;
=> nrel_main_idtf: [Un protocollo stabilisce il formato dei messaggi, l'ordine in cui vengono scambiati e le azioni da compiere alla loro ricezione.] (* <- lang_it;; *);;

..sentence_11_5
<- concept_sentence;
=> nrel_main_idtf: [Data la complessità del problema, i protocolli sono organizzati in livelli sovrapposti, ciascuno dei quali offre servizi al livello superiore e utilizza quelli del livello inferiore.] (* <- lang_it;; *);;

..sentence_11_6
<- concept_sentence;
=> nrel_main_idtf: [I dati da trasmettere vengono suddivisi in piccoli blocchi, detti pacchetti, ognuno dei quali contiene l'indirizzo del destinatario e viaggia in modo indipendente attraverso la rete.] (* <- lang_it;; *);;

..sentence_11_7
<- concept_sentence;
=> nrel_main_idtf: [Al livello di rete opera il protocollo IP, che assegna a ogni dispositivo un indirizzo IP e si occupa di trasportare i pacchetti dalla sorgente alla destinazione.] (* <- lang_it;; *);;

..sentence_11_8
<- concept_sentence;
=> nrel_main_idtf: [I router sono i dispositivi incaricati dell'instradamento: per ogni pacchetto ricevuto consultano una tabella e decidono su quale collegamento inoltrarlo.] (* <- lang_it;; *);;

..sentence_11_9
<- concept_sentence;
=> nrel_main_idtf: [Le tabelle di instradamento vengono costruite automaticamente da protocolli che scambiano informazioni sulla topologia della rete, come OSPF all'interno di un'organizzazione e BGP tra i diversi fornitori di servizi.] (* <- lang_it;; *);;

..sentence_11_10
<- concept_sentence;
=> nrel_main_idtf: [Il protocollo TCP fornisce un canale affidabile e ordinato: numera i dati, richiede conferme di ricezione e ritrasmette i pacchetti perduti.] (* <- lang_it;; *);;

