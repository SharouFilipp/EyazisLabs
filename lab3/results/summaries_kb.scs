// ===== Документ 2: Les bases de données relationnelles et le langage SQL =====
document_2
<- concept_document;
<- concept_scientific_article_computer_science;
=> nrel_main_idtf: [Les bases de données relationnelles et le langage SQL] (* <- lang_fr;; *);
=> nrel_text_language: lang_fr;
=> nrel_source_document: [http://localhost:8003/documents/2/file];
=> nrel_summary: classic_summary_2;
=> nrel_keywords: keyword_summary_2;;

classic_summary_2
<- concept_classic_summary;
=> nrel_summarization_method: method_sentence_extraction;
-> rrel_1: ..sentence_2_1;
-> rrel_2: ..sentence_2_2;
-> rrel_3: ..sentence_2_3;
-> rrel_4: ..sentence_2_4;
-> rrel_5: ..sentence_2_5;
-> rrel_6: ..sentence_2_6;
-> rrel_7: ..sentence_2_7;
-> rrel_8: ..sentence_2_8;
-> rrel_9: ..sentence_2_9;
-> rrel_10: ..sentence_2_10;;

..sentence_2_1
<- concept_sentence;
=> nrel_main_idtf: [Une base de données est un ensemble organisé d'informations, géré par un logiciel spécialisé appelé système de gestion de bases de données.] (* <- lang_fr;; *);;

..sentence_2_2
<- concept_sentence;
=> nrel_main_idtf: [Son rôle est de stocker les données de manière durable, de permettre leur consultation rapide et de garantir leur cohérence même lorsque de nombreux utilisateurs travaillent simultanément.] (* <- lang_fr;; *);;

..sentence_2_3
<- concept_sentence;
=> nrel_main_idtf: [Parmi les différents modèles proposés depuis les années soixante, le modèle relationnel est devenu dominant et reste aujourd'hui au cœur de la plupart des applications de gestion.] (* <- lang_fr;; *);;

..sentence_2_4
<- concept_sentence;
=> nrel_main_idtf: [Le modèle relationnel a été introduit par Edgar Codd en 1970 avec une idée simple : représenter toutes les données sous forme de relations, c'est-à-dire de tables composées de lignes et de colonnes.] (* <- lang_fr;; *);;

..sentence_2_5
<- concept_sentence;
=> nrel_main_idtf: [Chaque ligne correspond à un objet du monde réel, par exemple un client ou une commande, et chaque colonne à un attribut de cet objet.] (* <- lang_fr;; *);;

..sentence_2_6
<- concept_sentence;
=> nrel_main_idtf: [La notion de clé joue un rôle central dans l'organisation des relations.] (* <- lang_fr;; *);;

..sentence_2_7
<- concept_sentence;
=> nrel_main_idtf: [Une clé primaire identifie de façon unique chaque ligne d'une table, tandis qu'une clé étrangère établit un lien entre deux tables en faisant référence à la clé primaire d'une autre relation.] (* <- lang_fr;; *);;

..sentence_2_8
<- concept_sentence;
=> nrel_main_idtf: [Le langage SQL est le langage standard des bases de données relationnelles.] (* <- lang_fr;; *);;

..sentence_2_9
<- concept_sentence;
=> nrel_main_idtf: [Une requête de sélection indique les colonnes souhaitées, les tables concernées et les conditions que doivent satisfaire les lignes.] (* <- lang_fr;; *);;

..sentence_2_10
<- concept_sentence;
=> nrel_main_idtf: [Les formes normales successives visent à éliminer les redondances et les anomalies de mise à jour qui apparaissent lorsqu'une même information est stockée à plusieurs endroits.] (* <- lang_fr;; *);;

