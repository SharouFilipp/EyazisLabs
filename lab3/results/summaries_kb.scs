// ===== Документ 12: L'elaborazione del linguaggio naturale: metodi e applicazioni =====
document_12
<- concept_document;
<- concept_scientific_article_computer_science;
=> nrel_main_idtf: [L'elaborazione del linguaggio naturale: metodi e applicazioni] (* <- lang_it;; *);
=> nrel_text_language: lang_it;
=> nrel_source_document: [http://localhost:8003/documents/12/file];
=> nrel_summary: classic_summary_12;
