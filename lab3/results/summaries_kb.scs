// ===== Документ 5: Madame Bovary de Flaubert : le rêve romanesque face à la réalité =====
document_5
<- concept_document;
<- concept_literary_essay;
=> nrel_main_idtf: [Madame Bovary de Flaubert : le rêve romanesque face à la réalité] (* <- lang_fr;; *);
=> nrel_text_language: lang_fr;
