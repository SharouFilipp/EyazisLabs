// ===== Документ 1: Les algorithmes de tri : principes, complexité et usages =====
document_1
<- concept_document;
<- concept_scientific_article_computer_science;
=> nrel_main_idtf: [Les algorithmes de tri : principes, complexité et usages] (* <- lang_fr;; *);
=> nrel_text_language: lang_fr;
=> nrel_source_document: [http://localhost:8003/documents/1/file];
=> nrel_summary: classic_summary_1;
=> nrel_keywords: keyword_summary_1;;

classic_summary_1
<- concept_classic_summary;
=> nrel_summarization_method: method_sentence_extraction;
-> rrel_1: ..sentence_1_1;
-> rrel_2: ..sentence_1_2;
-> rrel_3: ..sentence_1_3;
-> rrel_4: ..sentence_1_4;
-> rrel_5: ..sentence_1_5;
-> rrel_6: ..sentence_1_6;
-> rrel_7: ..sentence_1_7;
-> rrel_8: ..sentence_1_8;
-> rrel_9: ..sentence_1_9;
-> rrel_10: ..sentence_1_10;;

..sentence_1_1
<- concept_sentence;
=> nrel_main_idtf: [Le tri est l'une des opérations les plus fondamentales de l'informatique, car un grand nombre de traitements supposent que les données soient d'abord ordonnées.] (* <- lang_fr;; *);;

..sentence_1_2
<- concept_sentence;
=> nrel_main_idtf: [Rechercher un élément, éliminer les doublons, fusionner deux listes ou construire un index devient beaucoup plus simple lorsque les valeurs sont rangées selon une relation d'ordre.] (* <- lang_fr;; *);;

..sentence_1_3
<- concept_sentence;
=> nrel_main_idtf: [Un algorithme de tri par comparaison ne dispose que d'une seule opération pour obtenir de l'information sur les données : comparer deux éléments et savoir lequel est le plus petit.] (* <- lang_fr;; *);;

..sentence_1_4
<- concept_sentence;
=> nrel_main_idtf: [Tout algorithme de ce type doit effectuer, dans le pire des cas, un nombre de comparaisons proportionnel à n log n pour trier n éléments.] (* <- lang_fr;; *);;

..sentence_1_5
<- concept_sentence;
=> nrel_main_idtf: [Le tri par insertion parcourt le tableau de gauche à droite et insère chaque nouvel élément à sa place dans la partie déjà triée.] (* <- lang_fr;; *);;

..sentence_1_6
<- concept_sentence;
=> nrel_main_idtf: [Sa complexité est quadratique dans le pire des cas, mais il est très rapide sur des tableaux presque triés et sur de petites séquences.] (* <- lang_fr;; *);;

..sentence_1_7
<- concept_sentence;
=> nrel_main_idtf: [Le tri fusion repose sur le principe « diviser pour régner » : le tableau est coupé en deux moitiés, chaque moitié est triée récursivement, puis les deux séquences triées sont fusionnées.] (* <- lang_fr;; *);;

..sentence_1_8
<- concept_sentence;
=> nrel_main_idtf: [Le tri rapide, proposé par Tony Hoare, choisit un élément appelé pivot et partitionne le tableau en deux zones : les éléments plus petits que le pivot et les éléments plus grands.] (* <- lang_fr;; *);;

..sentence_1_9
<- concept_sentence;
=> nrel_main_idtf: [En moyenne, le tri rapide effectue environ n log n comparaisons avec une constante très faible, et il travaille directement dans le tableau sans mémoire supplémentaire importante.] (* <- lang_fr;; *);;

..sentence_1_10
<- concept_sentence;
=> nrel_main_idtf: [Le tri par tas utilise une structure de données particulière, le tas binaire, dans laquelle chaque nœud est supérieur à ses descendants.] (* <- lang_fr;; *);;

keyword_summary_1
<- concept_keyword_summary;
-> rrel_1: kw_fr_tri;  // w(t,D) = 2.0794
-> rrel_2: kw_fr_fusion;  // w(t,D) = 1.2823
-> rrel_3: kw_fr_tas;  // w(t,D) = 1.2477
-> rrel_4: kw_fr_comparaisons;  // w(t,D) = 1.2130
-> rrel_5: kw_fr_log;  // w(t,D) = 1.1784
-> rrel_6: kw_fr_pire;  // w(t,D) = 1.1784
-> rrel_7: kw_fr_pivot;  // w(t,D) = 1.1784
-> rrel_8: kw_fr_borne;  // w(t,D) = 1.1437
-> rrel_9: kw_fr_choix;  // w(t,D) = 1.1437
-> rrel_10: kw_fr_recursivement;;  // w(t,D) = 1.1437

