// ===== Документ 6: Les Misérables de Victor Hugo : un roman de la rédemption et de la justice sociale =====
document_6
<- concept_document;
<- concept_literary_essay;
=> nrel_main_idtf: [Les Misérables de Victor Hugo : un roman de la rédemption et de la justice sociale] (* <- lang_fr;; *);
=> nrel_text_language: lang_fr;
=> nrel_source_document: [http://localhost:8003/documents/6/file];
=> nrel_summary: classic_summary_6;
