// ===== Документ 10: I sistemi operativi: gestione dei processi, della memoria e dei file =====
document_10
<- concept_document;
<- concept_scientific_article_computer_science;
=> nrel_main_idtf: [I sistemi operativi: gestione dei processi, della memoria e dei file] (* <- lang_it;; *);
=> nrel_text_language: lang_it;
=> nrel_source_document: [http://localhost:8003/documents/10/file];
=> nrel_summary: classic_summary_10;
=> nrel_keywords: keyword_summary_10;;

classic_summary_10
<- concept_classic_summary;
=> nrel_summarization_method: method_sentence_extraction;
-> rrel_1: ..sentence_10_1;
-> rrel_2: ..sentence_10_2;
-> rrel_3: ..sentence_10_3;
-> rrel_4: ..sentence_10_4;
-> rrel_5: ..sentence_10_5;
-> rrel_6: ..sentence_10_6;
-> rrel_7: ..sentence_10_7;
-> rrel_8: ..sentence_10_8;
-> rrel_9: ..sentence_10_9;
-> rrel_10: ..sentence_10_10;;

..sentence_10_1
<- concept_sentence;
=> nrel_main_idtf: [Il sistema operativo è il software fondamentale che gestisce le risorse di un calcolatore e offre ai programmi un ambiente di esecuzione comodo e sicuro.] (* <- lang_it;; *);;

..sentence_10_2
<- concept_sentence;
=> nrel_main_idtf: [Senza di esso, ogni applicazione dovrebbe controllare direttamente il processore, la memoria e i dispositivi, con enormi difficoltà di programmazione.] (* <- lang_it;; *);;

..sentence_10_3
<- concept_sentence;
=> nrel_main_idtf: [La parte centrale del sistema operativo è il nucleo, o kernel, che viene eseguito in una modalità privilegiata del processore.] (* <- lang_it;; *);;

..sentence_10_4
<- concept_sentence;
=> nrel_main_idtf: [Questa separazione protegge il sistema da programmi difettosi o malevoli, poiché un errore in un'applicazione non può danneggiare direttamente il nucleo.] (* <- lang_it;; *);;

..sentence_10_5
<- concept_sentence;
=> nrel_main_idtf: [Un processo è un programma in esecuzione, con il proprio spazio di indirizzamento, i propri registri e le proprie risorse.] (* <- lang_it;; *);;

..sentence_10_6
<- concept_sentence;
=> nrel_main_idtf: [Il sistema operativo crea e termina i processi, li sospende e li riprende, e tiene traccia del loro stato in apposite strutture dati.] (* <- lang_it;; *);;

..sentence_10_7
<- concept_sentence;
=> nrel_main_idtf: [Poiché i processi pronti sono di solito più numerosi dei processori disponibili, il sistema operativo deve decidere quale eseguire in ogni istante: questo compito è chiamato scheduling.] (* <- lang_it;; *);;

..sentence_10_8
<- concept_sentence;
=> nrel_main_idtf: [Gli algoritmi di scheduling cercano di bilanciare obiettivi diversi, come la rapidità di risposta per i programmi interattivi, l'utilizzo efficiente del processore e l'equità tra gli utenti.] (* <- lang_it;; *);;

..sentence_10_9
<- concept_sentence;
=> nrel_main_idtf: [Quando più processi o thread accedono alle stesse risorse, è necessaria la sincronizzazione per evitare risultati incoerenti.] (* <- lang_it;; *);;

..sentence_10_10
<- concept_sentence;
=> nrel_main_idtf: [Grazie alla memoria virtuale, ogni processo ha l'impressione di disporre di uno spazio di indirizzamento ampio e continuo, indipendente dalla memoria fisica realmente installata.] (* <- lang_it;; *);;

