// ===== Документ 4: La compilation : du code source au programme exécutable =====
document_4
<- concept_document;
<- concept_scientific_article_computer_science;
=> nrel_main_idtf: [La compilation : du code source au programme exécutable] (* <- lang_fr;; *);
=> nrel_text_language: lang_fr;
=> nrel_source_document: [http://localhost:8003/documents/4/file];
=> nrel_summary: classic_summary_4;
=> nrel_keywords: keyword_summary_4;;

classic_summary_4
<- concept_classic_summary;
=> nrel_summarization_method: method_sentence_extraction;
-> rrel_1: ..sentence_4_1;
-> rrel_2: ..sentence_4_2;
-> rrel_3: ..sentence_4_3;
-> rrel_4: ..sentence_4_4;
-> rrel_5: ..sentence_4_5;
-> rrel_6: ..sentence_4_6;
-> rrel_7: ..sentence_4_7;
-> rrel_8: ..sentence_4_8;
-> rrel_9: ..sentence_4_9;
-> rrel_10: ..sentence_4_10;;

..sentence_4_1
<- concept_sentence;
=> nrel_main_idtf: [Un compilateur est un programme qui traduit un texte écrit dans un langage de programmation de haut niveau en un code exécutable par la machine.] (* <- lang_fr;; *);;

..sentence_4_2
<- concept_sentence;
=> nrel_main_idtf: [Grâce à lui, le programmeur peut exprimer ses idées avec des notions abstraites, comme les fonctions, les boucles ou les objets, sans se préoccuper des détails du processeur.] (* <- lang_fr;; *);;

..sentence_4_3
<- concept_sentence;
=> nrel_main_idtf: [Le travail d'un compilateur est traditionnellement découpé en plusieurs phases successives.] (* <- lang_fr;; *);;

..sentence_4_4
<- concept_sentence;
=> nrel_main_idtf: [La partie frontale analyse le code source et en construit une représentation interne, tandis que la partie arrière transforme cette représentation en instructions pour une architecture donnée.] (* <- lang_fr;; *);;

..sentence_4_5
<- concept_sentence;
=> nrel_main_idtf: [La première phase est l'analyse lexicale, qui découpe la suite de caractères du programme en unités appelées lexèmes : mots-clés, identificateurs, nombres, opérateurs et signes de ponctuation.] (* <- lang_fr;; *);;

..sentence_4_6
<- concept_sentence;
=> nrel_main_idtf: [L'analyse syntaxique vérifie ensuite que la suite de lexèmes respecte la grammaire du langage et construit un arbre syntaxique qui reflète la structure du programme.] (* <- lang_fr;; *);;

..sentence_4_7
<- concept_sentence;
=> nrel_main_idtf: [Il existe deux grandes familles d'analyseurs : les analyseurs descendants, qui partent du symbole initial et cherchent à dériver le programme, et les analyseurs ascendants, qui regroupent progressivement les lexèmes en constructions plus larges.] (* <- lang_fr;; *);;

..sentence_4_8
<- concept_sentence;
=> nrel_main_idtf: [Un programme syntaxiquement correct peut encore contenir des erreurs de sens, que détecte l'analyse sémantique.] (* <- lang_fr;; *);;

..sentence_4_9
<- concept_sentence;
=> nrel_main_idtf: [Le compilateur vérifie que chaque variable est déclarée avant son utilisation, que les types des opérandes sont compatibles et que les fonctions sont appelées avec le bon nombre d'arguments.] (* <- lang_fr;; *);;

..sentence_4_10
<- concept_sentence;
=> nrel_main_idtf: [Après les analyses, le compilateur traduit l'arbre syntaxique en un code intermédiaire, indépendant à la fois du langage source et de la machine cible.] (* <- lang_fr;; *);;

