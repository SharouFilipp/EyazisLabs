// ===== Документ 9: La crittografia a chiave pubblica e la sicurezza delle comunicazioni =====
document_9
<- concept_document;
<- concept_scientific_article_computer_science;
=> nrel_main_idtf: [La crittografia a chiave pubblica e la sicurezza delle comunicazioni] (* <- lang_it;; *);
=> nrel_text_language: lang_it;
=> nrel_source_document: [http://localhost:8003/documents/9/file];
=> nrel_summary: classic_summary_9;
=> nrel_keywords: keyword_summary_9;;

classic_summary_9
<- concept_classic_summary;
=> nrel_summarization_method: method_sentence_extraction;
-> rrel_1: ..sentence_9_1;
-> rrel_2: ..sentence_9_2;
