// ===== Документ 3: Les réseaux de neurones artificiels et l'apprentissage profond =====
document_3
<- concept_document;
<- concept_scientific_article_computer_science;
=> nrel_main_idtf: [Les réseaux de neurones artificiels et l'apprentissage profond] (* <- lang_fr;; *);
=> nrel_text_language: lang_fr;
=> nrel_source_document: [http://localhost:8003/documents/3/file];
=> nrel_summary: classic_summary_3;
=> nrel_keywords: keyword_summary_3;;

classic_summary_3
<- concept_classic_summary;
=> nrel_summarization_method: method_sentence_extraction;
-> rrel_1: ..sentence_3_1;
-> rrel_2: ..sentence_3_2;
-> rrel_3: ..sentence_3_3;
-> rrel_4: ..sentence_3_4;
-> rrel_5: ..sentence_3_5;
-> rrel_6: ..sentence_3_6;
-> rrel_7: ..sentence_3_7;
-> rrel_8: ..sentence_3_8;
-> rrel_9: ..sentence_3_9;
-> rrel_10: ..sentence_3_10;;

..sentence_3_1
<- concept_sentence;
=> nrel_main_idtf: [Les réseaux de neurones artificiels sont des modèles de calcul inspirés, de manière très simplifiée, du fonctionnement du cerveau.] (* <- lang_fr;; *);;

..sentence_3_2
<- concept_sentence;
=> nrel_main_idtf: [Ils occupent aujourd'hui une place centrale en intelligence artificielle, car ils permettent de reconnaître des images, de traduire des textes ou de transcrire la parole avec une précision inconnue il y a encore quelques décennies.] (* <- lang_fr;; *);;

..sentence_3_3
<- concept_sentence;
=> nrel_main_idtf: [L'élément de base d'un réseau est le neurone artificiel, qui reçoit plusieurs valeurs d'entrée, les multiplie par des poids, additionne le résultat et applique une fonction d'activation.] (* <- lang_fr;; *);;

..sentence_3_4
<- concept_sentence;
=> nrel_main_idtf: [Les premiers modèles, comme le perceptron proposé par Frank Rosenblatt à la fin des années cinquante, utilisaient une simple fonction à seuil.] (* <- lang_fr;; *);;

..sentence_3_5
<- concept_sentence;
=> nrel_main_idtf: [Les réseaux modernes emploient des fonctions d'activation non linéaires, par exemple la fonction sigmoïde ou la fonction ReLU, qui renvoie zéro pour les valeurs négatives.] (* <- lang_fr;; *);;

..sentence_3_6
<- concept_sentence;
=> nrel_main_idtf: [La couche d'entrée reçoit les données, les couches cachées effectuent des transformations successives et la couche de sortie produit le résultat, par exemple la probabilité qu'une image représente un chat.] (* <- lang_fr;; *);;

..sentence_3_7
<- concept_sentence;
=> nrel_main_idtf: [On parle d'apprentissage profond lorsque le réseau comporte de nombreuses couches cachées, chacune extrayant des représentations de plus en plus abstraites des données.] (* <- lang_fr;; *);;

..sentence_3_8
<- concept_sentence;
=> nrel_main_idtf: [L'apprentissage consiste à ajuster les poids du réseau afin de minimiser une fonction de perte qui mesure l'écart entre les prédictions et les réponses attendues.] (* <- lang_fr;; *);;

..sentence_3_9
<- concept_sentence;
=> nrel_main_idtf: [L'algorithme de rétropropagation calcule efficacement le gradient de la perte par rapport à tous les poids en propageant l'erreur de la sortie vers l'entrée, couche par couche.] (* <- lang_fr;; *);;

..sentence_3_10
<- concept_sentence;
=> nrel_main_idtf: [Un problème majeur est le surapprentissage : le réseau mémorise les exemples d'apprentissage au lieu d'apprendre des régularités générales, et ses performances chutent sur de nouvelles données.] (* <- lang_fr;; *);;

