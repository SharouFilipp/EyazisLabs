flowchart TD
    s([Начало]) --> a[/"Абзацы документа, язык, N, K;<br/>sc-память с базой знаний"/]
    a --> b["Выборка из sc-памяти понятий предметных<br/>областей и их идентификаторов на языке документа"]
    b --> c["Идентификаторы → последовательности основ<br/>(словарь понятий)"]
    c --> d["Разбиение текста на предложения;<br/>поиск упоминаний понятий (самое длинное совпадение)"]
    d --> e["Определение предметной области:<br/>понятия какой области упоминаются чаще"]
    e --> f["Повторная индексация предложений<br/>понятиями этой области; tf(c,D)"]
    f --> g["a0(c) = 0,5·(1 + tf/tf_max)·spec(c),<br/>spec = h/(h+1), h — глубина в иерархии"]
    g --> h["Распространение активации по связям онтологии:<br/>a(c) = a0(c) + 0,2·Σ a0(соседей)"]
    h --> i{"Выбрано N<br/>предложений?"}
    i -- нет --> j["Выбор предложения с максимальным приростом<br/>gain = Σ a(новых понятий) + 0,3·Σ a(покрытых)"]
    j --> i
    i -- да --> k["Предложения в порядке следования в тексте"]
    k --> l["Ключевые понятия: K понятий с max a(c),<br/>дочерние — под родительскими (nrel_inclusion)"]
    l --> m["Фрагмент SCs: semantic_summary, key_concepts"]
    m --> z([Конец])
