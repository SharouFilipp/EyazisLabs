flowchart TD
    s([Начало]) --> a["Открытие веб-страницы,<br/>создание таблиц БД"]
    a --> b[/"Загрузка документов"/]
    b --> c{"Формат поддерживается<br/>и есть текстовый слой?"}
    c -- нет --> err["Сообщение об ошибке"] --> b
    c -- да --> d["Извлечение абзацев, определение<br/>языка и предметной области"]
    d --> e["Запись в таблицу documents"]
    e --> f["Пересчёт df(t) по коллекции<br/>и построение рефератов"]
    f --> g["Запись sentences, terms, summaries"]
    g --> h["Отображение таблицы документов,<br/>реферата, SCg-графа, оценки"]
    h --> i{"Сохранить или<br/>распечатать?"}
    i -- да --> j[/"HTML / TXT / SCs / печать"/] --> k
    i -- нет --> k([Конец])
