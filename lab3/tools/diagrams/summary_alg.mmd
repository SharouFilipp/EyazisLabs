flowchart TD
    s([Начало]) --> a[/"Абзацы документа D, язык,<br/>df(t) и |DB| коллекции, N"/]
    a --> b["Разбиение абзацев на предложения S1…Sn;<br/>для каждого: BD(Si), |D|, BP(Si), |P|"]
    b --> c["Отбор терминов: без чисел, стоп-слов,<br/>слов короче 3 букв; стемминг Snowball"]
    c --> d["tf(t,D), tf_max(D)"]
    d --> e["w(t,D) = 0,5·(1 + tf/tf_max)·log(|DB|/df(t))"]
    e --> f["Score(Si) = Σ tf(t,Si)·w(t,D)"]
    f --> g["Posd(Si) = 1 − BD(Si)/|D|<br/>Posp(Si) = 1 − BP(Si)/|P|"]
    g --> h["Weight(Si) = Score · Posd · Posp"]
    h --> i["Выбор N предложений с наибольшим весом"]
    i --> j["Упорядочивание в порядке следования в тексте"]
    j --> k["Ключевые слова: термины с max w(t,D);<br/>уточнения — именные группы с термином"]
    k --> l[/"Классический реферат +<br/>реферат в виде ключевых слов"/]
    l --> m["Формирование фрагмента базы знаний SCs"]
    m --> z([Конец])
