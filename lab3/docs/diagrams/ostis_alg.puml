@startuml
' Алгоритм семантического метода OSTIS
!theme plain
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam ArrowColor #555555
skinparam ActivityBackgroundColor #FFF3F0
skinparam ActivityBorderColor #555555

start
:Абзацы документа, язык, N, K,
sc-память с базой знаний; <<input>>
:Выборка из sc-памяти понятий предметных
областей и их идентификаторов на языке документа;
:Идентификаторы → последовательности основ
(словарь понятий);
:Разбиение текста на предложения, поиск
упоминаний понятий (самое длинное совпадение);
:Определение предметной области:
понятия какой области встречаются чаще;
:Повторная индексация предложений понятиями
этой области, tf(c,D);
:a0(c) = 0,5·(1 + tf/tf_max)·spec(c)
spec = h/(h+1), h — глубина в иерархии;
:Распространение активации по связям онтологии
a(c) = a0(c) + 0,2·Σ a0(соседей);
while (Выбрано меньше N предложений?) is (да)
  :Выбор предложения с максимальным приростом
  gain = Σ a(новых понятий) + 0,3·Σ a(покрытых);
endwhile (нет)
:Предложения в порядке следования в тексте;
:Ключевые понятия: K понятий с max a(c),
дочерние — под родительскими (nrel_inclusion);
:Семантический реферат + ключевые понятия; <<output>>
:Фрагмент SCs: semantic_summary, key_concepts;
stop
@enduml
