    H -- нет --> P["Предобработка и токенизация"]
    P --> F["Частотные слова:<br/>подсчёт частот,<br/>top-200, p = count / N"]
    P --> K["Короткие слова:<br/>длина ≤ 5, частота > 3,<br/>p = count / Σcount"]
    P --> N["Нейросеть: 1500 случайных<br/>фрагментов 3–60 слов на язык,<br/>TF-IDF N-грамм, обучение MLP<br/>(Adam, early stopping)"]
    F --> W["Сохранение профилей<br/>JSON / joblib + хеш"]
    K --> W
    N --> W
    L --> E(["Конец"])
    W --> E
