flowchart TB
    S(["Начало"]) --> A[/"Входной документ PDF"/]
    A --> B["Извлечение текста из PDF"]
    B --> C["Шаг 1. Предобработка:<br/>NFC, нижний регистр, единый апостроф,<br/>склейка переносов, токенизация,<br/>удаление цифр и знаков препинания"]
    C --> D{"Метод"}
    D -- "частотных слов" --> F1["ПОД: последовательность слов w₁…wₙ"]
    F1 --> F2["Для каждого языка L:<br/>d(D,L) = −(1/n)·Σ log p(wᵢ|L)<br/>p = частота в ПОЯ (top-200)<br/>или p_min = 10⁻⁶"]
    D -- "коротких слов" --> K1["Разбиение на предложения,<br/>отбор слов длиной ≤ 5"]
    K1 --> K2["Для каждого языка L:<br/>log P(предложение|L) = Σ log p(w|L)<br/>d(D,L) = −(1/m)·Σ по предложениям"]
    D -- "нейросетевой" --> N1["Вектор TF-IDF<br/>символьных N-грамм (N=1…3)"]
    N1 --> N2["Многослойный перцептрон:<br/>4000 → 64 (ReLU) → softmax"]
    N2 --> N3["d(D,L) = 1 − P(L|D)"]
    F2 --> R["Шаг 2. Сравнение метрик<br/>d(D,en) и d(D,fr)"]
    K2 --> R
    N3 --> R
    R --> T["Шаг 3. Язык = argmin d(D,L)<br/>уверенность, время"]
    T --> O[/"Результат: язык,<br/>метрики, время → БД, отчёт"/]
    O --> E(["Конец"])
