@startuml
' Алгоритм перевода предложения системой с трансфером
!theme plain
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam ArrowColor #555555
skinparam ActivityBackgroundColor #FFF7E8
skinparam ActivityBorderColor #555555

start
:Английский текст; <<input>>
:Разбиение на абзацы, заголовки;
partition "Анализ" {
  :spaCy: токены, леммы, теги Penn,
  части речи, дерево зависимостей;
  :Предметная область по терминам словаря
  (computer science / литература);
}
partition "Лексический трансфер" {
  :Поиск оборотов: самая длинная
  последовательность лемм из таблицы phrases;
  :Для остальных слов — словарь
  по (лемма, часть речи, область);
  if (слова нет в словаре?) then (да)
    :производные (-ly, -ed, -ing),
    имя собственное или «неизвестное»;
  endif
}
partition "Структурный трансфер" {
  :Обход дерева от вершины предложения;
  :Клауза: подлежащее, время и залог,
  отрицание ne … pas, клитики le / la / lui,
  место наречий, управление глагола;
  :Именная группа: артикль по роли
  и числу, прилагательные после
  существительного (кроме pre), N1 of N2 → N1 de N2;
  :Предложная группа: выбор предлога
  (in → dans / en / à, by → par / de, …);
}
partition "Синтез" {
  :Спряжение (présent, passé composé,
  imparfait, futur, conditionnel), согласование
  прилагательных и причастий;
  :Слияние à le → au, de les → des,
  элизия le → l', пробелы перед ; : ? !;
}
:Французский перевод, статистика,
частотный список, деревья разбора; <<output>>
stop
@enduml
